# Copy this file to .env and fill it in. Never commit .env.

# Required. Bot token from the Discord Developer Portal → your app → Bot → Reset Token.
DISCORD_TOKEN=

# Server to archive. Discord → Settings → Advanced → Developer Mode,
# then right-click the server icon → Copy Server ID.
GUILD_ID=

# One channel, for `npm run text`. Right-click a channel → Copy Channel ID.
CHANNEL_ID=

# Optional. Comma-separated channel, category or thread IDs. If set, used instead of the whole server.
CHANNEL_IDS=

# Optional. Comma-separated channel names or IDs to leave out.
SKIP_CHANNELS=

# Optional. Only download these file types, e.g. .mp4,.mov
# Default: every photo, video and audio file.
MEDIA_EXTENSIONS=

# Optional. Where archives go (default: ./output).
OUTPUT_DIR=

# Optional. Files downloaded at once (default: 3).
DOWNLOAD_CONCURRENCY=

# Optional. Pause in milliseconds between 100-message pages (default: 250).
FETCH_DELAY_MS=

# Optional. Application ID, only for `npm run invite` if it can't read it from the token.
CLIENT_ID=
