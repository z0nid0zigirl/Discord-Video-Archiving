# Copy this file to .env and fill it in. Never commit .env.

# Required. Bot token from the Discord Developer Portal → your app → Bot → Reset Token.
DISCORD_TOKEN=

# Server to archive. Discord → Settings → Advanced → Developer Mode,
# then right-click the server icon → Copy Server ID.
GUILD_ID=

# One channel, for `npm run text`. Right-click a channel → Copy Channel ID.
CHANNEL_ID=

# Optional. Comma-separated channel IDs for `npm run text:multi`. If set, used instead of GUILD_ID.
CHANNEL_IDS=

# Optional. Comma-separated channel names to leave out of a whole-server run.
SKIP_CHANNELS=

# Optional. Comma-separated file types for `npm run media`, e.g. .mp3,.mp4,.wav
MEDIA_EXTENSIONS=
