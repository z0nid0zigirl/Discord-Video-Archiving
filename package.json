{
  "name": "discord-server-archiver",
  "version": "2.0.0",
  "description": "Archive a Discord server: messages, photos, videos and audio, in folders by category and channel.",
  "private": true,
  "scripts": {
    "archive": "node src/archive.js",
    "media": "node src/media-archiver.js",
    "text": "node src/text-archiver.js",
